manifest {
    mainScript = "main.nf"
}

params{
      input     = null  // input h5 file for VD analysis 
      combinDir = ""    // directory to combins file with pairs of phenotypes to analyse (for bivariate)
      phenos    = null  // uni/sex: number of phenotypes to analyse (one VD task per phenotype)
                        // bi: string selecting the combins files in combinDir (combins_<phenos>*.csv), leave empty for all
      outdir        = "./output"                        // output directory
      pipeline_info = "${params.outdir}/pipeline_info"  // directory where store pipeline information

      bitime    = "2.h"   // time for bivariate analysis - it depends on the structure of the dataset and the effects of model included
      vdMODEL   = "uni"   // model for VD analysis, uni, bi or sex
      PHENOV    = null    // phenotype version
      COVSV     = null    // covariates version
      CAGEV     = null    // cage version
      DAMV      = "None"  // dam version
      GRMV      = null    // grm version
      SEXV      = "None"  // sex version - in case sexvariate
      SUBSET    = "None"  // subset 
      EFFECTS   = null    // effects to include in the model, DGE, IGE, IEE, cageEffect, maternalEffect
      CORR_NULL = "None"  // corr to constrain to 0 or 1

      SWAPtraits = "FALSE"  // true when want to swap traits -> trait1 becomes trait2 and viceversa
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// ---- Defaults for every executor and container engine ----
process {
    cache     = "lenient"
    cpus      = 1
    memory    = { 1.GB * task.attempt }
    time      = { 30.min * task.attempt }

    errorStrategy = "retry"
    maxRetries    = 1

    // Memory classes
    withLabel: mem_1  { memory = "1 GB" }
    withLabel: mem_5  { memory = "5 GB" }
    withLabel: mem_40 { memory = "40 GB" }
    withLabel: mem_60 { memory = "60 GB" }

    // Time classes
    withLabel: time_1h { time = { 1.h * task.attempt } }
    withLabel: time_2h { time = { 2.h * task.attempt } }
    withLabel: time_6h { time = { 6.h * task.attempt } }

    withLabel: ignore  { errorStrategy = "ignore" }
}

profiles {
    // ---- Container engines (pick one) ----
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "--no-home"
        singularity.cacheDir   = "${HOME}/singularity/containers"   // or set NXF_SINGULARITY_CACHEDIR
        docker.enabled         = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    // ---- Infrastructure: CRG SLURM cluster ----
    crg {
        process {
            executor = "slurm"
            queue    = "genoa64"
            array    = 200
            clusterOptions = { task.time <= 3.h  ? "--qos=shorter" :
                               task.time <= 6.h  ? "--qos=short"   :
                               task.time <= 12.h ? "--qos=normal"  :
                               task.time <= 24.h ? "--qos=long"    :
                               task.time <= 48.h ? "--qos=vlong"   : "--qos=marathon" }
        }
    }
    
    // ---- Infrastructure: a single machine (laptop, workstation) ----
    local {
        process {
            executor       = "local"
            resourceLimits = [ memory: 16.GB, cpus: 4, time: 24.h ]
        }
    }

    // ---- Test: small dataset shipped with the repo (200 HS mice, 5 phenotypes) ----
    // e.g. nextflow run main.nf -profile test,docker,local
    //      for bivariate add: --vdMODEL bi ; for sexvariate add: --vdMODEL sex --SEXV all
    test {
        params {
            input         = "${projectDir}/../data/test.h5"
            combinDir     = "${projectDir}/input/dataset"   // has combins_5phenos.csv, used in bivariate
            phenos        = 5
            outdir        = "./test_output"
            pipeline_info = "./test_output/pipeline_info"

            vdMODEL   = "uni"
            PHENOV    = "data_bcNcovariates"
            COVSV     = "data_bcNcovariates"
            CAGEV     = "all"
            DAMV      = "None"
            GRMV      = "Andres_kinship"
            SEXV      = "None"
            SUBSET    = "None"
            EFFECTS   = "DGE,IGE,cageEffect"
            CORR_NULL = "None"
        }
    }
}

// For trace
params.run_day  = new Date().format("yyyyMMdd")
params.run_hour = new Date().format("HHmm")

timeline {
  enabled = true
  file = "${params.pipeline_info}/${params.run_day}/timeline_${params.run_hour}.html"
  overwrite = true
}


report {
  enabled = true
  file = "${params.pipeline_info}/${params.run_day}/trace_${params.run_hour}.html"
  overwrite = true
}


