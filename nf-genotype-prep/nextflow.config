manifest {
    mainScript = "main.nf"
}

params{
    //    Execution options // execute all by default
    skip_vcf =     false
    skip_bychr =   false
    skip_pruning = false
    skip_grm =     false
    
    //    Output
    outdir = "./output/"
    trace_dir = "${params.outdir}/pipeline_info"
    
    //    Input
    input_vcf = null
    individ = null
    plink_file = null
    
    //    Parameters
    chr = null
    
    // prune options
    prune_window = 50
    prune_step = 5
    prune_r2 = 2
    
    // GRM options
    maf = 0.05
    geno = 0.1    
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// ---- Defaults for every executor and container engine ----
process {
    cache     = "lenient"
    cpus      = 1
    memory    = { 1.GB * task.attempt }
    time      = { 30.min * task.attempt }

    errorStrategy = "retry"
    maxRetries    = 1

    // Memory classes
    withLabel: mem_1  { memory = "1 GB" }
    withLabel: mem_5  { memory = "5 GB" }
    withLabel: mem_40 { memory = "40 GB" }
    withLabel: mem_60 { memory = "60 GB" }

    // Time classes
    withLabel: time_1h { time = { 1.h * task.attempt } }
    withLabel: time_2h { time = { 2.h * task.attempt } }
    withLabel: time_6h { time = { 6.h * task.attempt } }

    withLabel: ignore  { errorStrategy = "ignore" }
}

profiles {
    // ---- Container engines (pick one) ----
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "--no-home"
        singularity.cacheDir   = "${HOME}/singularity/containers"   // or set NXF_SINGULARITY_CACHEDIR
        docker.enabled         = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    // ---- Infrastructure: CRG SLURM cluster ----
    crg {
        process {
            executor = "slurm"
            queue    = "genoa64"
            array    = 200
            clusterOptions = { task.time <= 3.h  ? "--qos=shorter" :
                               task.time <= 6.h  ? "--qos=short"   :
                               task.time <= 12.h ? "--qos=normal"  :
                               task.time <= 24.h ? "--qos=long"    :
                               task.time <= 48.h ? "--qos=vlong"   : "--qos=marathon" }
        }
    }
    
    // ---- Infrastructure: a single machine (laptop, workstation) ----
    local {
        process {
            executor       = "local"
            resourceLimits = [ memory: 16.GB, cpus: 4, time: 24.h ]
        }
    }
}

// For trace
params.run_day  = new Date().format("yyyyMMdd")
params.run_hour = new Date().format("HHmm")

timeline {
  enabled = true
  file = "${params.pipeline_info}/${params.run_day}/timeline_${params.run_hour}.html"
  overwrite = true
}


report {
  enabled = true
  file = "${params.pipeline_info}/${params.run_day}/trace_${params.run_hour}.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.pipeline_info}/${params.run_day}/dag_${params.run_hour}.png"
  overwrite = true
}

